# NO save-exact. Every @memberjunction/* and @mj-biz-apps/* spec in this repo is a
# CARET range, not an exact pin — an exact pin does not link to a local sibling under
# pnpm (a member links only when its local version satisfies the consumer's declared
# range), which is what silently resolved workspace packages from the registry before.
# save-exact=true would quietly re-pin the next dependency anyone adds and reintroduce
# exactly that failure.

# Strict SSL
strict-ssl=true
