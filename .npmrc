# NPM Configuration for bizapps-issues

# Save exact versions (matching MJ pattern)
save-exact=true

# Use lockfile
package-lock=true

# Allow flexible peer dependency resolution (required for the Angular workspace —
# same setting bizapps-common and bizapps-tasks ship; without it npm 7+ rejects
# the exact-pin + caret-peer mix on a fresh resolve)
legacy-peer-deps=true

# Strict SSL
strict-ssl=true
