{
  "version": "1.0.0",
  "push": {
    "autoCreateMissingRecords": true
  },
  "directoryOrder": [
    "applications",
    "application-roles",
    "issue-statuses",
    "issue-types",
    "entities",
    "entity-relationships",
    "record-processes",
    "ml-training-pipelines",
    "ml-models",
    "ml-model-scoring-bindings"
  ],
  "sqlLogging": {
    "enabled": true,
    "outputDirectory": "./sql_logging",
    "formatAsMigration": true,
    "filterPatterns": [
      "*spCreateAIPromptRun*",
      "*spUpdateAIPromptRun*"
    ],
    "filterType": "exclude"
  },
  "emitSyncNotes": false
}
